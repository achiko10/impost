# Environment variables for maintenance_system
# Copy this to .env and set appropriate values

# Django Core Settings
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Database (for PostgreSQL in production)
DATABASE_URL=postgres://user:password@localhost:5432/maintenance_db

# Cloudinary (for cloud image storage)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Email Configuration (Gmail example)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Security Settings (enable in production with HTTPS)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=True
